# nginx.conf template for Hermes Web (frontend-only Docker image).
# ${HERMES_GATEWAY_URL} and ${HERMES_HOME} are substituted by
# docker-entrypoint.sh (envsubst) at container start; every other $var is nginx's own.

pid "${HERMES_STATE_DIR}/nginx.pid";
error_log stderr;
events {}

http {
    include /etc/nginx/mime.types;
    access_log /dev/stdout;
    client_body_temp_path "${HERMES_STATE_DIR}/client";
    proxy_temp_path "${HERMES_STATE_DIR}/proxy";
    default_type application/octet-stream;

    # Upgrade/Connection map needed for the /api/ws WebSocket proxy.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # A TLS-terminating reverse proxy (such as Cloudflare) may connect to this
    # nginx over HTTP while the browser is using HTTPS. Preserve its original
    # scheme so the gateway builds correct OAuth redirects and secure cookies.
    map $http_x_forwarded_proto $hermes_forwarded_proto {
        default $scheme;
        http    http;
        https   https;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    server {
        listen ${HERMES_LISTEN};
        server_name _;

        root "${HERMES_STATIC_ROOT}";
        index index.html;

        # Container runtime configuration must not outlive a gateway change.
        location = /gateway-config.js {
            add_header Cache-Control "no-store";
        }

        location = /runtime-config.js {
            add_header Cache-Control "no-store";
        }

        # Cache static build assets aggressively (content-hashed filenames).
        location /assets/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Hermes gateway — REST + WebSocket, same-origin (auth cookies/ws-tickets).
        location ~ ^(${HERMES_PROXY_ROUTES}) {
            proxy_pass ${HERMES_GATEWAY_URL};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
            proxy_read_timeout 3600s;
        }

        # Desktop / agent plugin assets, served from the mounted hermes config
        # dir: /plugins -> $HERMES_HOME/plugins, /desktop-plugins -> $HERMES_HOME/desktop-plugins
        location /desktop-plugins/ {
            alias "${HERMES_HOME}/desktop-plugins/";
        }
        location /plugins/ {
            alias "${HERMES_HOME}/plugins/";
        }

        # Live dir listing for the bridge's readDir() (fixed in v0.1.1 — this used
        # to hardcode `[]` for /plugins and 404 for /desktop-plugins regardless of
        # what was actually mounted). nginx autoindex only answers URIs ending in
        # '/', so we internally rewrite each `.listing` request to its trailing-
        # slash form and serve that via nginx's built-in autoindex (JSON) against
        # the real ${HERMES_HOME} directory — the same [{name,type}] shape as the
        # dev middleware in vite.config.ts. Using an internal `rewrite ... last`
        # (not an external redirect) avoids emitting a Location header, which
        # could point at the wrong scheme/port when nginx sits behind a proxy.
        location = /plugins/.listing { rewrite ^ /plugins/.listing/ last; }
        location = /plugins/.listing/ {
            alias "${HERMES_HOME}/plugins/";
            autoindex on;
            autoindex_format json;
        }
        location = /desktop-plugins/.listing { rewrite ^ /desktop-plugins/.listing/ last; }
        location = /desktop-plugins/.listing/ {
            alias "${HERMES_HOME}/desktop-plugins/";
            autoindex on;
            autoindex_format json;
        }

        # SPA fallback: any unknown route serves the app shell (hash-routed SPA).
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
