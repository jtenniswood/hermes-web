{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "../desktop/src/debug/**",
    "../desktop/src/**/*.test.ts",
    "../desktop/src/**/*.test.tsx",
    "../desktop/src/**/*.test-d.ts",
    "../desktop/src/**/*.spec.ts",
    "../desktop/src/**/*.spec.tsx",
    "../shared/src/**/*.test.ts",
    "../shared/src/**/*.test-d.ts"
  ],
  "extends": "./tsconfig.aliases.json"
}
