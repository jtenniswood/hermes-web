{
  "name": "hermes-mobile",
  "private": true,
  "version": "0.1.1",
  "description": "Hermes Desktop — Web & Mobile (PWA) version. Official Hermes chat UI as a browser/PWA app; nix-free Docker build.",
  "scripts": {
    "dev": "pnpm --filter web-desktop run dev",
    "build": "pnpm --filter web-desktop run build",
    "typecheck": "node scripts/typecheck.mjs",
    "deploy": "bash apps/web-desktop/scripts/deploy.sh",
    "prepare:renderer": "node scripts/renderer.mjs",
    "check:renderer": "node scripts/renderer.mjs --check",
    "test:foundation": "node --test scripts/*.test.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
